# Hoist tailwindcss to root node_modules so that CSS @import "tailwindcss"
# in workspace libs (e.g. libs/ui) can be resolved by @tailwindcss/vite even
# though tailwindcss is only declared as a dependency of apps/web.
public-hoist-pattern[]=tailwindcss
public-hoist-pattern[]=@tailwindcss/*

# Same reason, for Tamagui. The tamagui vite plugin GENERATES `<app>/.tamagui/tamagui.config.mjs`
# inside each product SPA and that file imports `@tamagui/core` — but the SPAs depend on it only
# transitively, through `@lmthing/ui`, so pnpm's strict linking left it unresolvable and every SPA
# image build died with "Cannot find package '@tamagui/core'". The app never wrote that import, so
# hoisting is the honest fix rather than declaring a dependency each app does not itself use.
public-hoist-pattern[]=@tamagui/*
