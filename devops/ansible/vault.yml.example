# Ansible Vault template — fill in all values, then:
#   ansible-vault encrypt vault.yml
# To edit later:
#   ansible-vault edit vault.yml

# ── Domain ────────────────────────────────────────────────────
vault_domain: lmthing.cloud
vault_computer_domain: lmthing.computer
vault_auth_domain: auth.lmthing.cloud
vault_base_url: https://lmthing.cloud
vault_acme_email: admin@lmthing.cloud

# ── Azure Foundry ─────────────────────────────────────────────
vault_azure_api_key: your-azure-api-key
vault_azure_api_base: https://your-resource.openai.azure.com

# ── PostgreSQL ────────────────────────────────────────────────
# Generate passwords with: openssl rand -hex 24
vault_postgres_user: lmthing
vault_postgres_password: CHANGE_ME
vault_zitadel_db_password: CHANGE_ME
vault_database_url: postgresql://lmthing:CHANGE_ME@postgres:5432/lmthing
# Used by the migration runner to connect as superuser
vault_db_password: CHANGE_ME   # same as vault_postgres_password

# ── Zitadel ───────────────────────────────────────────────────
# Master key: generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
# Must be exactly 32 hex characters (16 bytes)
vault_zitadel_master_key: CHANGE_ME_32_HEX_CHARS
vault_zitadel_admin_password: CHANGE_ME
vault_zitadel_issuer: https://auth.lmthing.cloud
# Fill these in AFTER initial Zitadel setup (see Zitadel Setup section in devops/CLAUDE.md)
vault_zitadel_service_pat: ""        # Machine user Personal Access Token
vault_zitadel_github_idp_id: ""      # Optional — auto-discovered if blank
vault_zitadel_client_id: ""
vault_zitadel_client_secret: ""

# ── Gateway JWT ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
vault_gateway_jwt_secret: CHANGE_ME

# ── GitHub App (workspace backup) ─────────────────────────────
# Powers the "Workspace Backup" feature. Create a GitHub App (Contents: read &
# write, Metadata: read, no webhooks; Setup URL https://lmthing.cloud/api/backup/callback;
# installable on "Any account"). Leave blank to keep the feature disabled — the
# gateway reports `configured: false` and the UI hides it.
vault_github_app_id: ""            # numeric App ID from the App's General page
vault_github_app_slug: ""          # public slug (…/apps/<slug>)
# Paste the downloaded .pem as a YAML block scalar, e.g.:
#   vault_github_app_private_key: |
#     -----BEGIN RSA PRIVATE KEY-----
#     ...
#     -----END RSA PRIVATE KEY-----
vault_github_app_private_key: ""

# In-app bug reporter (POST /api/issues) — a GitHub PAT used to file issues into
# lmthing/org and commit trace/screenshot artifacts. Classic token needs `repo`
# scope; a fine-grained token needs Issues:write + Contents:write on the org
# (and the GITHUB_BUGREPORT_REPO storage repo). Leave blank to disable the
# feature (the endpoint returns 501). Storage repo is set via the plain
# GITHUB_BUGREPORT_REPO env in argocd/core/gateway.yaml (default lmthing/bug-reports).
vault_github_issues_token: ""

# ── OAuth integrations (Connections: Google / Slack / GitHub) ──
# Per-provider OAuth *client* creds (distinct from the workspace-backup GitHub
# App above). Each provider's redirect URI must be
# https://lmthing.cloud/api/connections/callback. A provider left blank reports
# configured:false and is simply not connectable (no breakage).
#   Google : Google Cloud Console → Credentials → OAuth client (Web); enable Gmail + Calendar
#   Slack  : api.slack.com/apps → OAuth & Permissions (bot scopes chat:write,channels:read,search:read)
#   GitHub : github.com/settings/developers → OAuth Apps (NOT a GitHub App)
vault_google_oauth_client_id: ""
vault_google_oauth_client_secret: ""
vault_slack_oauth_client_id: ""
vault_slack_oauth_client_secret: ""
vault_github_oauth_client_id: ""
vault_github_oauth_client_secret: ""
# AES-256-GCM key that encrypts stored OAuth tokens at rest. REQUIRED for any
# connection to work (blank ⇒ connect/token-mint throw). Generate:
#   openssl rand -base64 32
vault_connections_enc_key: ""

# ── Render service (in-cluster headless-browser used by webSearch google provider) ──
# Shared bearer token authenticating pod → render service requests. Generate:
#   openssl rand -base64 32
vault_render_service_token: ""

# ── Scenario dashboard (automation/app) ──────────────────────
# Shared bearer token gating the dashboard viewer + the local client ingest.
# Generate with: openssl rand -base64 32
vault_dash_view_token: ""

# ── Stripe ────────────────────────────────────────────────────
vault_stripe_secret_key: sk_live_xxx
vault_stripe_webhook_secret: whsec_xxx
vault_stripe_price_basic: price_xxx
vault_stripe_price_pro: price_xxx
vault_stripe_price_max: price_xxx

# ── LiteLLM ───────────────────────────────────────────────────
# Generate with: echo "sk-lmt-$(openssl rand -hex 32)"
vault_litellm_master_key: sk-lmt-xxx

# ── ACR (Azure Container Registry) ───────────────────────────
vault_acr_registry: lmthingacr.azurecr.io
vault_acr_username: lmthingacr
vault_acr_password: your-acr-password



# ── OTA updates (expo-open-ota) ──────────────────────────────
# The mobile app checks https://lmthing.cloud/ota/manifest on launch and runs whatever
# JavaScript that server signs for it, so the signing key below is as sensitive as
# GATEWAY_JWT_SECRET — anyone holding it can push code into every installed copy.
#
# The PUBLIC half is a certificate committed at
# sdk/org/apps/mobile/certs/certificate.pem and compiled into the app binary; the
# private half is gitignored and lives only here. Generate the pair with:
#   openssl genrsa -out private-key.pem 4096
#   openssl pkcs8 -topk8 -nocrypt -in private-key.pem -out private-key.pem
#   openssl req -x509 -key private-key.pem -out certificate.pem -days 3650 -sha256 \
#     -subj "/CN=lmthing OTA/O=lmthing" \
#     -addext "keyUsage=critical,digitalSignature" \
#     -addext "extendedKeyUsage=critical,codeSigning"
#
# Both are supplied base64 (KEYS_STORAGE_TYPE=environment), which keeps a PEM's
# newlines out of YAML and out of a k8s env var:
#   base64 -w0 sdk/org/apps/mobile/certs/private-key.pem
#   base64 -w0 sdk/org/apps/mobile/certs/certificate.pem
vault_expo_updates_private_key_b64: ""
vault_expo_updates_public_key_b64: ""
# Signs dashboard sessions and the upload tokens the eoas CLI presents. The SAME value
# goes in the EXPO_OPEN_OTA_TOKEN GitHub secret used by .github/workflows/ota-publish.yml.
# Generate with: openssl rand -base64 32
vault_expo_updates_jwt_secret: ""
# Encrypts the per-app keys the control plane stores. 32 bytes, base64:
#   openssl rand -base64 32
vault_expo_updates_db_master_key_b64: ""
# Dashboard sign-in (USE_DASHBOARD=true on the Deployment).
vault_expo_updates_admin_email: ""
vault_expo_updates_admin_password: ""
# No storage credentials: STORAGE_MODE is `local` against the ota-updates PVC
# (devops/argocd/core/ota.yaml). Moving to Azure Blob later adds
# AZURE_STORAGE_ACCOUNT_NAME / AZURE_STORAGE_ACCOUNT_KEY / AZURE_BLOB_CONTAINER_NAME.
# DB_URL is BUILT from vault_postgres_user/password against the `ota` database, so it is
# not a separate secret here.
