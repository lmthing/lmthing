{
  "name": "lmthing-dsh",
  "private": true,
  "description": "Experimental, non-production track: LMThing space format as plugins for DeepSeek Harness (dsh).",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "dsh": "dsh",
    "tracer:headless": "dsh --profile headless",
    "assemble:lmthing-profile": "node scripts/assemble-lmthing-profile.mjs lmthing",
    "assemble:lmthing-web-profile": "node scripts/assemble-lmthing-profile.mjs lmthing-web"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@lmthing/dsh-space-format": "workspace:*",
    "@lmthing/dsh-space-functions": "workspace:*",
    "@lmthing/dsh-space-persona": "workspace:*",
    "@lmthing/dsh-space-delegate": "workspace:*",
    "@lmthing/dsh-space-tasklist": "workspace:*",
    "@lmthing/dsh-space-knowledge": "workspace:*",
    "@lmthing/dsh-space-components": "workspace:*",
    "@lmthing/dsh-space": "workspace:*",
    "yaml": "^2.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  }
}
