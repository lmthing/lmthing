# dsh (DeepSeek Harness) compute pod image — the SECOND per-user Deployment/Service
# (`lmthing-dsh`), serving lmthing.chat ONLY (Part B cutover, see dsh/PROGRESS.md).
#
# Build context note: the Docker build context must be the `dsh/` workspace root
# (i.e. `docker build -f devops/argocd/compute/Dockerfile.dsh dsh/`).
#
# Pushed as its own image (`compute-dsh`), NEVER as `compute` — studio, computer, team, and app all
# proxy `/api/*` to the SAME per-user Service the existing `compute` image serves (confirmed by
# reading chat-policies.yaml's own comment: "identical logic to computer-lua-routing" builds the
# IDENTICAL upstream `lmthing.user-<id>.svc.cluster.local:8080` for every one of them). Swapping
# `compute` itself to dsh would silently break every one of those surfaces the moment this pod's
# `/api/*` stopped being the old @lmthing/cli REST API — they were never asked to move. So dsh runs
# as a genuinely SEPARATE Deployment+Service per user (`lmthing-dsh`, see
# cloud/gateway/src/lib/compute.ts#dshDeployment/dshService), and only chat-lua-routing's upstream
# construction points at it; every other surface's routing is untouched.
#
# Why a wrapper process (@lmthing/dsh-pod-server) is the CMD, not `dsh` directly: dsh refuses to
# bind any host but loopback (`--host 0.0.0.0` is intentionally rejected — confirmed by reading
# @deepseek-ai/dsh-web-app's own startup.js) and ships no `/api/health` route at all (confirmed by
# grepping every installed dsh-* package). The wrapper binds 0.0.0.0:8080 for the K8s
# Service/startupProbe, reverse-proxies to dsh on loopback, and is the only thing answering health.
# See dsh/packages/pod-server/src/*.js for the full design (byte-identical proxying + a real model
# route to LiteLLM verified live before this Dockerfile was written).

# ---------------------------------------------------------------------------
# Stage 1 — builder (installs the pinned dsh graph from the committed lockfile)
# ---------------------------------------------------------------------------
FROM node:24-slim AS builder

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@10.17.1 --activate
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

# Manifests first so dependency installation is cached separately from source changes.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/client-space-components/package.json ./packages/client-space-components/package.json
COPY packages/llm-mock/package.json               ./packages/llm-mock/package.json
COPY packages/pod-server/package.json             ./packages/pod-server/package.json
COPY packages/preset-roster/package.json          ./packages/preset-roster/package.json
COPY packages/space/package.json                  ./packages/space/package.json
COPY packages/space-components/package.json       ./packages/space-components/package.json
COPY packages/space-delegate/package.json         ./packages/space-delegate/package.json
COPY packages/space-format/package.json           ./packages/space-format/package.json
COPY packages/space-functions/package.json        ./packages/space-functions/package.json
COPY packages/space-knowledge/package.json        ./packages/space-knowledge/package.json
COPY packages/space-persona/package.json          ./packages/space-persona/package.json
COPY packages/space-tasklist/package.json         ./packages/space-tasklist/package.json
COPY packages/subagent-preset/package.json        ./packages/subagent-preset/package.json

# --frozen-lockfile: the committed pnpm-lock.yaml is the pinned dsh graph (Part A0) — a build must
# never silently pick up a newer preview release of a 9-day-old breaking-change dependency.
RUN pnpm install --frozen-lockfile

# Full source (space-format etc. ship as native TS run directly by Node's type-stripping — no
# build step — so source IS the artifact for every @lmthing/dsh-* package).
COPY packages/ ./packages/
COPY scripts/  ./scripts/
COPY system-spaces/ ./system-spaces/

# Bake the `lmthing-web` dsh profile — package.json/cordis.yml/pnpm-workspace.yaml + a real
# `pnpm install` — here, at build time, since it's 100% static (same for every user, every boot).
# Landed outside /data so the runtime `emptyDir` mount at /data never shadows it; profile-bootstrap
# only needs to copy this + re-link its @lmthing/* symlinks (relative, and wrong at this depth —
# see that module's doc comment) at boot, never run `pnpm install` over the network again.
RUN node scripts/lmthing-web-profile-manifest.mjs /build /build/.profile-base/lmthing-web
RUN cd /build/.profile-base/lmthing-web && pnpm install

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM node:24-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/node_modules       ./node_modules
COPY --from=builder /build/packages           ./packages
COPY --from=builder /build/scripts            ./scripts
COPY --from=builder /build/system-spaces      ./system-spaces
COPY --from=builder /build/package.json       ./package.json
COPY --from=builder /build/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /build/.profile-base      ./.profile-base

# Runtime root — DSH_HOME (dsh's own $HOME-equivalent: profiles, sessions, credentials, the
# agent-presets roster) lives under /data, an `emptyDir` for THIS deployment (`lmthing-dsh`),
# not the primary pod's `user-data` PVC — deliberately, to avoid doubling per-user storage cost
# (see cloud/gateway/src/lib/compute.ts#dshDeployment). Genuinely empty on every restart, which
# is exactly why profile-bootstrap.js materializes the profile from this image's own
# .profile-base rather than assuming anything here survives a restart.
ENV DSH_HOME=/data/.dsh-home
RUN mkdir -p /data

EXPOSE 8080

CMD ["node", "packages/pod-server/src/index.js"]
